# Local development only. Do not reuse placeholder values outside dev.
COMPOSE_PROJECT_NAME=certgate

POSTGRES_DB=certgate
POSTGRES_USER=certgate
POSTGRES_PASSWORD=local-dev-change-me

MANAGEMENT_API_PORT=8080
ADMIN_CONSOLE_PORT=5173
GATEWAY_MTLS_PORT=8443
GATEWAY_INTERNAL_PORT=8081
BACKEND_SERVICE_PORT=8090

MANAGEMENT_API_URL=http://management-api:8080
BACKEND_SERVICE_URL=http://backend-service:8090
GATEWAY_INTERNAL_URL=http://gateway:8081

GATEWAY_SERVICE_TOKEN=local-dev-gateway-token-change-me
GATEWAY_INTERNAL_TOKEN=local-dev-internal-token-change-me

GATEWAY_ACCESS_CACHE_TTL_SECONDS=30
GATEWAY_OUTBOX_PATH=/data/outbox.db
GATEWAY_EVENT_BATCH_SIZE=50
GATEWAY_EVENT_RETRY_MAX_SECONDS=60

ENROLLMENT_TOKEN_TTL_HOURS=24
DEVICE_CERTIFICATE_VALIDITY_DAYS=30
CERTIFICATE_EXPIRING_SOON_DAYS=7

ROOT_CA_CERT_PATH=/run/certgate/root-ca.crt
INTERMEDIATE_CA_CERT_PATH=/run/certgate/intermediate-ca.crt
INTERMEDIATE_CA_KEY_PATH=/run/certgate/intermediate-ca.key
GATEWAY_SERVER_CERT_PATH=/run/certgate/gateway.crt
GATEWAY_SERVER_KEY_PATH=/run/certgate/gateway.key

VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SSE_URL=http://localhost:8080/api/v1/security-events/stream
